# ---------------------------------------------------------------
# LABONNO — environment variables
# Copy to .env.local and fill in real values. Never commit secrets.
# ---------------------------------------------------------------

# Core
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=LABONNO

# MongoDB (Atlas in production, local mongod in development)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=labonno
# Better Auth writes a user + password in one transaction when the deployment can.
# Atlas / replica sets / mongos: leave empty (auto-detected). Plain local mongod
# (the default Windows install) cannot use transactions — set this to false.
MONGODB_TRANSACTIONS=

# Better Auth
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional — button is hidden when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (optional — falls back to local /public/uploads in dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=labonno

# bKash (sandbox/production credentials)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Nagad
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_BASE_URL=https://sandbox.mynagad.com

# SSLCommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# Owner addresses — these emails always have full studio access (/admin).
# Comma separated. The panel can add more under Admin → Users.
OWNER_EMAILS=marufsalauddioffical@gmail.com

# Admin seed credentials (development only)
SEED_ADMIN_EMAIL=marufsalauddioffical@gmail.com
SEED_ADMIN_PASSWORD=Labonno@2026
SEED_STAFF_EMAIL=manager@labonno.com
SEED_STAFF_PASSWORD=Labonno@2026
SEED_CUSTOMER_EMAIL=customer@labonno.com
SEED_CUSTOMER_PASSWORD=Labonno@2026

# ── Order emails (Resend) ────────────────────────────────────────────────
# Create a key at https://resend.com/api-keys, then verify your sending domain.
RESEND_API_KEY=
EMAIL_FROM="Labonno <orders@yourdomain.com>"
EMAIL_REPLY_TO=hello@yourdomain.com
# While testing you can send every email to one inbox:
EMAIL_TEST_OVERRIDE=

# ── bKash tokenized checkout (automatic payments) ────────────────────────
# From the bKash merchant portal. Leave empty to keep using manual bKash.
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true

# ── Analytics (optional; nothing loads until an id is present) ───────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
